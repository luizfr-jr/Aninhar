# Copie este arquivo para .env. Nunca versione as credenciais reais.
# Senha administrativa com pelo menos 12 caracteres, escolhida por você.
ADMIN_PASSWORD=
# Segredo aleatório com pelo menos 32 caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=
# Origem exata do site. Desenvolvimento Vite:
APP_ORIGIN=http://localhost:3000
# Em produção, use o endereço HTTPS público e NODE_ENV=production.
NODE_ENV=development
PORT=3001
DATA_DIR=./data

# Opcional: IPs/CIDRs exatos dos proxies reversos, separados por vírgula.
# Deixe vazio se clientes acessam Node diretamente. Nunca use true, números de
# saltos, redes /0 ou redes amplas que incluam clientes não confiáveis.
# Exemplo apenas quando o proxy realmente conecta via loopback: 127.0.0.1,::1
TRUST_PROXY=
